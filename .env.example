# Application
NODE_ENV=development

# PostgreSQL
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://dependabot:change_me@localhost:5432/dependabot_agent
DIRECT_URL=postgresql://dependabot:change_me@localhost:5432/dependabot_agent
SHADOW_DATABASE_URL=postgresql://dependabot:change_me@localhost:5432/dependabot_shadow
TEST_DATABASE_URL=postgresql://dependabot:change_me@localhost:5432/dependabot_agent_test

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# GitHub App
GITHUB_APP_ID=replace_with_github_app_id
GITHUB_INSTALLATION_ID=replace_with_installation_id
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem

# AI provider
AI_PROVIDER=openai
AI_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional model overrides
# AI_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# GOOGLE_MODEL=

# Remediation
REMEDIATION_WORKSPACE_ROOT=
REMEDIATION_DOCKER_IMAGE=dependabot-remediation-node:22
REMEDIATION_EXECUTION_TIMEOUT_MS=600000
REMEDIATION_DOCKER_CONTROL_TIMEOUT_MS=15000
REMEDIATION_MAX_OUTPUT_LENGTH=65536
REMEDIATION_MEMORY=1g
REMEDIATION_MEMORY_SWAP=1g
REMEDIATION_CPUS=1
REMEDIATION_PIDS_LIMIT=128
REMEDIATION_TMP_SIZE_MB=128

# Worker scheduling intervals (milliseconds)
OUTBOX_POLL_INTERVAL_MS=5000
ANALYSIS_RECOVERY_INTERVAL_MS=15000
