
FROM node:22-bookworm-slim

ENV NODE_ENV=development
ENV HOME=/tmp
ENV npm_config_cache=/tmp/.npm

WORKDIR /workspace

# Usuário sem privilégios. O executor poderá sobrescrever
# o UID/GID para corresponder ao proprietário do workspace.
RUN groupadd --gid 10001 runner \
    && useradd \
      --uid 10001 \
      --gid 10001 \
      --no-create-home \
      --shell /usr/sbin/nologin \
      runner

USER runner

CMD ["node", "--version"]
