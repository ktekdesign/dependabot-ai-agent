{
  "name": "dependabot-ai-agent",
  "version": "0.0.1",
  "description": "An autonomous AI-powered agent for analyzing and remediating Dependabot security vulnerabilities.",
  "author": "Dependabot AI Agent contributors",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "sync:github": "npm run build && node scripts/sync-github.cjs"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.5",
    "@langchain/core": "^1.4.2",
    "@langchain/google-genai": "^2.3.6",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@langchain/openai": "^1.8.4",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/schedule": "^6.1.3",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.5",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "tar": "^7.5.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "esbuild": "0.26.0",
    "multer": "2.5.0",
    "@nestjs/cli": {
      "glob": "14.0.2"
    },
    "qs": "6.16.2",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.22.1"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
